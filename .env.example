# Copia este archivo como .env y completa los valores. .env está en .gitignore: nunca se sube.

# Obligatoria para el chat. Sin ella el servidor arranca, pero /api/chat responde 503.
ANTHROPIC_API_KEY=

# Modelo y comportamiento (opcionales; estos son los valores por defecto)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=90000

# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=600000
MAX_TOKENS_SERVIDOR=6000000
MAX_SESIONES=200

# Si se define, el front pide esta clave y la API la exige en el encabezado x-access-key.
ACCESS_KEY=

PORT=3000
